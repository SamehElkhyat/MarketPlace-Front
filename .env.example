# URL of the deployed (or local) Atelier API. The browser never calls it directly:
# Next rewrites /api/* to this URL, so cookies are first-party and no CORS is needed.
BACKEND_URL=http://localhost:4000

# Public URL of THIS site (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for POST /revalidate. Must equal REVALIDATE_SECRET in the API project.
REVALIDATE_SECRET=change-me

# Optional: "Continue with Google" button (Google Identity Services client id).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: error tracking.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
